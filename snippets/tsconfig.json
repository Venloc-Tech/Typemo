{
  // For the editor only: the documentation examples in this folder resolve the packages the way
  // scripts/docs-check.ts compiles them. Not referenced from the root tsconfig.json, so `tsc -b` never builds them;
  // examples that show a compile error on purpose (`// @errors`) stay red here.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@venloc/typemo": ["../packages/typemo/src/index.ts"],
      "@venloc/typemo/testing": ["../packages/typemo/src/testing/index.ts"],
      "@venloc/typemo-decorators": ["../packages/decorators/src/index.ts"],
      "@venloc/typemo-nestjs": ["../integrations/nestjs/src/index.ts"],
      "@venloc/typemo-nestjs/testing": ["../integrations/nestjs/src/testing/index.ts"],
      "mongodb": ["../packages/typemo/node_modules/mongodb"],
      "@nestjs/common": ["../integrations/nestjs/node_modules/@nestjs/common"],
      "@nestjs/core": ["../integrations/nestjs/node_modules/@nestjs/core"],
      "@nestjs/testing": ["../integrations/nestjs/node_modules/@nestjs/testing"],
      "rxjs": ["../integrations/nestjs/node_modules/rxjs"]
    }
  },
  "include": ["**/*.ts"]
}
