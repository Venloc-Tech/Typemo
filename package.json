{
  "name": "typemo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "integrations/*"
  ],
  "scripts": {
    "test": "bun run --filter '*' test",
    "test:perf": "bun run --cwd packages/typemo test:perf && bun run --cwd integrations/opentelemetry test:perf",
    "test:types": "tsc -p tsconfig.test.json && tsc -p packages/test-kit/fixtures/dist-consumer/tsconfig.suite.json && tsc -p packages/decorators/test/package/tsconfig.json && tsc -p packages/decorators/test/strict/tsconfig.json && tsc -p packages/decorators/test/shared/tc39/tsconfig.json",
    "test:hover": "bun test hover/ shape/",
    "test:decorators": "cd packages/decorators/test/shared/legacy && bun test ./shared.suite.ts && cd ../tc39 && bun test ./shared.suite.ts",
    "typecheck": "bun run scripts/clean-dist.ts && tsc -b",
    "typecheck:timing": "bun run scripts/typecheck-timing.ts",
    "typecheck:budget": "bun run scripts/typecheck-budget.ts",
    "check:any": "bun run scripts/check-any.ts",
    "check:tsdoc": "bun run scripts/check-tsdoc-examples.ts",
    "forms:table": "bun run scripts/value-forms-table.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "research:graph": "bun run scripts/research/build-graph.ts",
    "research:questions": "bun run scripts/research/questions-index.ts",
    "bench": "bun run --cwd packages/bench src/cli/main.ts",
    "bench:quick": "bun run --cwd packages/bench src/cli/main.ts --profile quick",
    "bench:standard": "bun run --cwd packages/bench src/cli/main.ts --profile standard",
    "clean:dist": "bun run scripts/clean-dist.ts",
    "build": "bun run scripts/build.ts",
    "test:dist": "bun run scripts/test-dist.ts",
    "check:skills": "bun run scripts/check-skills.ts",
    "release:dry": "bun scripts/publish.ts --dry-run",
    "release": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "expect-type": "1.4.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "mongodb": "7.6.0"
  },
  "license": "MIT",
  "author": "Shiz-Ceo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venloc-Tech/typemo.git"
  }
}
