{
  "name": "@venloc/typemo-opentelemetry",
  "version": "1.0.0",
  "description": "OpenTelemetry instrumentation for Typemo: spans and metrics of operations and driver commands.",
  "keywords": [
    "mongodb",
    "typemo",
    "opentelemetry",
    "tracing",
    "observability"
  ],
  "license": "MIT",
  "author": "Shiz-Ceo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venloc-Tech/typemo.git",
    "directory": "integrations/opentelemetry"
  },
  "homepage": "https://github.com/Venloc-Tech/typemo#readme",
  "bugs": {
    "url": "https://github.com/Venloc-Tech/typemo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run ../../scripts/build.ts .",
    "test": "bun test --path-ignore-patterns 'test/perf/**'",
    "test:perf": "bun test test/perf"
  },
  "peerDependencies": {
    "@venloc/typemo": "^1.0.0",
    "@opentelemetry/api": "^1.9.1"
  },
  "devDependencies": {
    "@venloc/typemo": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@venloc/typemo-test-kit": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
