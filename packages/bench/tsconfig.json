{
  // Not a project reference of the root build: Typemo's EMITTED declarations lose typed filters/updates
  // (BOARD: BB 2026-09-27, reported as a library bug), so the bench is checked against the SOURCES,
  // like tsconfig.test.json does. Check: `bun run typecheck` in this package (tsc -p).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@venloc/typemo": ["../typemo/src/index.ts"],
      "@venloc/typemo/testing": ["../typemo/src/testing/index.ts"],
      "@venloc/typemo-test-kit": ["../test-kit/src/index.ts"]
    }
  },
  "include": ["src", "test", "scripts"]
}
