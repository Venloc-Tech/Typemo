{
  "name": "@venloc/typemo",
  "version": "1.0.0",
  "description": "A strictly typed ODM for MongoDB: class-and-decorator schemas, types inferred from the implementation, strict by default.",
  "keywords": [
    "mongodb",
    "odm",
    "typescript",
    "typed",
    "mongoose",
    "typegoose",
    "mongoose-alternative",
    "decorators",
    "schema"
  ],
  "license": "MIT",
  "author": "Shiz-Ceo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venloc-Tech/typemo.git",
    "directory": "packages/typemo"
  },
  "homepage": "https://github.com/Venloc-Tech/typemo#readme",
  "bugs": {
    "url": "https://github.com/Venloc-Tech/typemo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run ../../scripts/build.ts .",
    "test": "bun test --path-ignore-patterns 'test/guards/perf/**'",
    "test:perf": "bun test test/guards/perf"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "mongodb": "^7.6.0",
    "bson": "^7.3.3"
  },
  "devDependencies": {
    "mongodb": "^7.6.0",
    "bson": "^7.3.3",
    "@venloc/typemo-test-kit": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
