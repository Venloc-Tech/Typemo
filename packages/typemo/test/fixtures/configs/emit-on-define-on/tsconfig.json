{
  "//": "A user project configuration for runtime tests of the schema layer (Bun takes the tsconfig of the cwd).",
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "strict": true
  }
}
