{
  "SharedAuthor": {
    "name": "SharedAuthor",
    "kind": "document",
    "collection": "shared_authors",
    "discriminators": [],
    "paths": {
      "_id": {
        "kind": "scalar",
        "type": "objectId",
        "flags": "required,immutable,default,service:id"
      },
      "name": {
        "kind": "scalar",
        "type": "string",
        "flags": "required"
      }
    },
    "indexes": [],
    "searchIndexes": [],
    "virtuals": ["populate:posts"],
    "hooks": {}
  },
  "SharedPost": {
    "name": "SharedPost",
    "kind": "document",
    "collection": "shared_posts",
    "discriminators": [],
    "paths": {
      "_id": {
        "kind": "scalar",
        "type": "objectId",
        "flags": "required,immutable,default,service:id"
      },
      "title": {
        "kind": "scalar",
        "type": "string",
        "flags": "required"
      },
      "views": {
        "kind": "scalar",
        "type": "number",
        "flags": "default"
      },
      "author": {
        "kind": "scalar",
        "type": "objectId",
        "flags": "required,ref"
      }
    },
    "indexes": [
      {
        "keys": {
          "title": 1,
          "views": -1
        },
        "options": {}
      }
    ],
    "searchIndexes": [],
    "virtuals": [],
    "hooks": {}
  },
  "SharedPerson": {
    "name": "SharedPerson",
    "kind": "document",
    "collection": "shared_people",
    "discriminators": ["admin"],
    "paths": {
      "_id": {
        "kind": "scalar",
        "type": "objectId",
        "flags": "required,immutable,default,service:id"
      },
      "name": {
        "kind": "scalar",
        "type": "string",
        "flags": "required",
        "ext": {
          "testLabel": {
            "label": "Name"
          }
        }
      },
      "email": {
        "kind": "scalar",
        "type": "string"
      },
      "secret": {
        "kind": "scalar",
        "type": "string"
      },
      "tags": {
        "kind": "array",
        "flags": "default"
      },
      "tags.$": {
        "kind": "scalar",
        "type": "string"
      },
      "scores": {
        "kind": "array",
        "flags": "default"
      },
      "scores.$": {
        "kind": "scalar",
        "type": "number"
      },
      "address": {
        "kind": "nested",
        "type": "SharedAddress"
      },
      "address.city": {
        "kind": "scalar",
        "type": "string",
        "flags": "required"
      },
      "address.zip": {
        "kind": "scalar",
        "type": "string"
      },
      "pets": {
        "kind": "array",
        "flags": "default"
      },
      "pets.$": {
        "kind": "subdocument",
        "type": "SharedPet"
      },
      "pets.$.name": {
        "kind": "scalar",
        "type": "string",
        "flags": "required"
      },
      "pets.$.age": {
        "kind": "scalar",
        "type": "number"
      },
      "counters": {
        "kind": "map"
      },
      "counters.$*": {
        "kind": "scalar",
        "type": "number"
      },
      "seenAt": {
        "kind": "scalar",
        "type": "date",
        "flags": "nullable"
      },
      "__t": {
        "kind": "scalar",
        "type": "string",
        "flags": "service:discriminatorKey"
      }
    },
    "indexes": [
      {
        "keys": {
          "email": 1
        },
        "options": {
          "unique": true,
          "partialFilterExpression": {
            "email": {
              "$exists": true
            }
          }
        }
      }
    ],
    "searchIndexes": [],
    "virtuals": [],
    "hooks": {
      "pre document.save": 2,
      "post document.save": 1,
      "postError document.save": 1
    },
    "ext": {
      "testLabel": {
        "group": "people"
      }
    }
  },
  "SharedLedger": {
    "name": "SharedLedger",
    "kind": "document",
    "collection": "shared_ledgers",
    "discriminators": [],
    "paths": {
      "_id": {
        "kind": "scalar",
        "type": "objectId",
        "flags": "required,immutable,default,service:id"
      },
      "__v": {
        "kind": "scalar",
        "type": "number",
        "flags": "service:version"
      },
      "owner": {
        "kind": "scalar",
        "type": "string",
        "flags": "required"
      },
      "balance": {
        "kind": "scalar",
        "type": "number",
        "flags": "required"
      }
    },
    "indexes": [],
    "searchIndexes": [],
    "virtuals": [],
    "hooks": {}
  }
}
