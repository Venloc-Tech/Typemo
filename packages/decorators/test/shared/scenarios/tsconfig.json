{
  // Two readers. Bun takes `paths` from the tsconfig nearest to the importing file: the alias goes to the runtime
  // bridge, which hands out the decorators the runner's preload registered, and the core resolves from sources (the
  // package exports point at dist, and two copies of the core would keep two metadata registries: "not a schema").
  // The IDE checks the scenario files with this file too, so it extends the repository base in the legacy mode;
  // the runners' tsconfigs (and the root tsconfig.test.json) are what `test:types` uses.
  "extends": "../../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@typemo-shared/decorators": ["./active-decorators.ts"],
      "@venloc/typemo": ["../../../../typemo/src/index.ts"],
      "@venloc/typemo/adapters": ["../../../../typemo/src/adapters.ts"],
      "@venloc/typemo/testing": ["../../../../typemo/src/testing/index.ts"],
      "@venloc/typemo-test-kit": ["../../../../test-kit/src/index.ts"]
    }
  },
  "include": ["./*.ts"]
}
