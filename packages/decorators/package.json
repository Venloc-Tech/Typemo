{
  "name": "@venloc/typemo-decorators",
  "version": "1.0.0",
  "description": "TC39 (standard) decorators for Typemo schemas.",
  "keywords": [
    "mongodb",
    "odm",
    "typemo",
    "decorators",
    "tc39"
  ],
  "license": "MIT",
  "author": "Shiz-Ceo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venloc-Tech/typemo.git",
    "directory": "packages/decorators"
  },
  "homepage": "https://github.com/Venloc-Tech/typemo#readme",
  "bugs": {
    "url": "https://github.com/Venloc-Tech/typemo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run ../../scripts/build.ts .",
    "test": "bun test test/package test/strict",
    "test:shared": "cd test/shared/legacy && bun test ./shared.suite.ts && cd ../tc39 && bun test ./shared.suite.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@venloc/typemo": "^1.0.0"
  },
  "devDependencies": {
    "@venloc/typemo": "workspace:*"
  }
}
