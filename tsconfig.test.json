{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@venloc/typemo": ["./packages/typemo/src/index.ts"],
      "@venloc/typemo/testing": ["./packages/typemo/src/testing/index.ts"],
      "@venloc/typemo/adapters": ["./packages/typemo/src/adapters.ts"],
      "@venloc/typemo-decorators": ["./packages/decorators/src/index.ts"],
      "@venloc/typemo-nestjs": ["./integrations/nestjs/src/index.ts"],
      "@venloc/typemo-nestjs/testing": ["./integrations/nestjs/src/testing/index.ts"],
      "@venloc/typemo-test-kit": ["./packages/test-kit/src/index.ts"],
      // Shared decorators suite (PLAN 12.4): type-checked here in legacy mode; the TC39 side has its own tsconfig.
      "@typemo-shared/decorators": ["./packages/decorators/test/shared/legacy/decorators.ts"]
    }
  },
  "include": [
    "packages/*/test/**/*.ts",
    "integrations/*/test/**/*.ts",
    "integrations/*/demo/**/*.ts",
    "scripts/*.ts",
    "scripts/**/*.ts"
  ],
  // TC39 tests are type-checked by their own tsconfigs (test:types runs them too): a legacy project cannot compile them.
  "exclude": [
    "packages/decorators/test/package/**",
    "packages/decorators/test/strict/**",
    "packages/decorators/test/shared/tc39/**"
  ]
}
