{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun"],

    // Stage 2 decision E3: Bun and tsc agree only with `false`. Hydration must
    // not depend on this flag in user projects (see research/DECISIONS.md E3).
    "useDefineForClassFields": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,

    // The workspace packages resolve to their SOURCES (types for tsc, module resolution for Bun): their package.json
    // `exports` point at the built `dist`, which only the consumer test (`bun run test:dist`) reads.
    "paths": {
      "@venloc/typemo": ["./packages/typemo/src/index.ts"],
      "@venloc/typemo/testing": ["./packages/typemo/src/testing/index.ts"],
      "@venloc/typemo/adapters": ["./packages/typemo/src/adapters.ts"],
      "@venloc/typemo-decorators": ["./packages/decorators/src/index.ts"],
      "@venloc/typemo-nestjs": ["./integrations/nestjs/src/index.ts"],
      "@venloc/typemo-nestjs/testing": ["./integrations/nestjs/src/testing/index.ts"],
      "@venloc/typemo-test-kit": ["./packages/test-kit/src/index.ts"]
    },

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "emitDeclarationOnly": true
  }
}
